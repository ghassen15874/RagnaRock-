//! Direct Linux syscall implementation
#![no_std]
#![cfg(target_os = "linux")]

use core::arch::asm;

#[repr(C)]
#[derive(Debug, Copy, Clone)]
pub struct UserRegsStruct {
    pub r15: u64,
    pub r14: u64,
    pub r13: u64,
    pub r12: u64,
    pub rbp: u64,
    pub rbx: u64,
    pub r11: u64,
    pub r10: u64,
    pub r9: u64,
    pub r8: u64,
    pub rax: u64,
    pub rcx: u64,
    pub rdx: u64,
    pub rsi: u64,
    pub rdi: u64,
    pub orig_rax: u64,
    pub rip: u64,
    pub cs: u64,
    pub eflags: u64,
    pub rsp: u64,
    pub ss: u64,
    pub fs_base: u64,
    pub gs_base: u64,
    pub ds: u64,
    pub es: u64,
    pub fs: u64,
    pub gs: u64,
}

#[no_mangle]
pub unsafe extern "C" fn direct_syscall(
    syscall_number: u64,
    arg1: u64,
    arg2: u64,
    arg3: u64,
    arg4: u64,
    arg5: u64,
    arg6: u64,
) -> u64 {
    let ret: u64;
    
    asm!(
        "syscall",
        in("rax") syscall_number,
        in("rdi") arg1,
        in("rsi") arg2,
        in("rdx") arg3,
        in("r10") arg4,
        in("r8") arg5,
        in("r9") arg6,
        lateout("rax") ret,
        options(nostack, preserves_flags)
    );
    
    ret
}

// Common syscall wrappers
#[no_mangle]
pub unsafe fn sys_execve(filename: *const u8, argv: *const *const u8, envp: *const *const u8) -> u64 {
    direct_syscall(59, filename as u64, argv as u64, envp as u64, 0, 0, 0)
}

#[no_mangle]
pub unsafe fn sys_mmap(addr: *mut u8, length: usize, prot: i32, flags: i32, fd: i32, offset: i64) -> u64 {
    direct_syscall(9, addr as u64, length as u64, prot as u64, flags as u64, fd as u64, offset as u64)
}

#[no_mangle]
pub unsafe fn sys_mprotect(addr: *mut u8, len: usize, prot: i32) -> u64 {
    direct_syscall(10, addr as u64, len as u64, prot as u64, 0, 0, 0)
}

#[no_mangle]
pub unsafe fn sys_ptrace(request: i32, pid: i32, addr: *mut u8, data: *mut u8) -> u64 {
    direct_syscall(101, request as u64, pid as u64, addr as u64, data as u64, 0, 0)
}

// Advanced memory operations
#[no_mangle]
pub unsafe fn allocate_rwx_memory(size: usize) -> *mut u8 {
    let addr = sys_mmap(
        std::ptr::null_mut(),
        size,
        0x7, // PROT_READ | PROT_WRITE | PROT_EXEC
        0x22, // MAP_PRIVATE | MAP_ANONYMOUS
        -1,
        0
    );
    
    addr as *mut u8
}

#[no_mangle]
pub unsafe fn execute_shellcode(shellcode: *const u8, size: usize) -> u64 {
    let exec_mem = allocate_rwx_memory(size);
    
    if exec_mem.is_null() {
        return 0;
    }
    
    // Copy shellcode to executable memory
    std::ptr::copy_nonoverlapping(shellcode, exec_mem, size);
    
    // Execute
    let func: extern "C" fn() -> u64 = std::mem::transmute(exec_mem);
    let result = func();
    
    // Free memory
    sys_munmap(exec_mem, size);
    
    result
}

#[no_mangle]
pub unsafe fn sys_munmap(addr: *mut u8, length: usize) -> u64 {
    direct_syscall(11, addr as u64, length as u64, 0, 0, 0, 0)
}